rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminDoc() { return get(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().data.active == true;
    }
    function isOwner() { return isAdmin() && adminDoc().data.role == 'owner'; }

    match /admins/{userId} {
      allow read: if isAdmin();
      allow create, update, delete: if isOwner();
    }

    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /slotLocks/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /bookingRequests/{documentId} {
      allow create, read, update, delete: if isAdmin();
    }
    match /enquiries/{documentId} {
      allow create: if request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }
    match /feedbackSubmissions/{documentId} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.website == ''
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow read, update, delete: if isAdmin();
    }
    match /publicFeedback/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /applications/{documentId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /bookings/{documentId} { allow read, write: if isAdmin(); }
    match /payments/{documentId} { allow read, write: if isAdmin(); }

    // Admin-only operational collections introduced by the rebuilt dashboard.
    match /teamMembers/{documentId} { allow read, write: if isAdmin(); }
    match /customerProfiles/{documentId} { allow read, write: if isAdmin(); }
    match /emailTemplates/{documentId} { allow read, write: if isAdmin(); }
    match /emailHistory/{documentId} { allow read, write: if isAdmin(); }
    match /emailDrafts/{documentId} { allow read, write: if isAdmin(); }
    match /activityLogs/{documentId} {
      allow read, create: if isAdmin();
      allow update, delete: if isOwner();
    }
    match /archives/{documentId} { allow read, write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
